APP_NAME=behu-api
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
AUTO_CREATE_TABLES=true
# true solo en el sandbox de Render. En local puedes dejarlo en false y correr el script.
AUTO_SEED_SANDBOX=false

# SQLite (sandbox local /docs). Para Railway usa PostgreSQL asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./behu_sandbox.db
# DATABASE_URL=postgresql+asyncpg://behu:behu@localhost:5432/behu

# MongoDB (Motor) — hábitos e IA
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=behu

# JWT — mínimo 32 caracteres. Nunca commitear el valor real.
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS. FRONTEND_URL es el origen de Vercel y se suma a la lista.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000
FRONTEND_URL=

# AWS S3 para KYC. Vacío = guardado local en data/kyc/
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_S3_KYC_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
