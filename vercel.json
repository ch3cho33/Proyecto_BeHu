{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/docs(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/openapi.json",
      "destination": { "service": "app" }
    },
    {
      "source": "/redoc",
      "destination": { "service": "app" }
    },
    {
      "source": "/health",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
